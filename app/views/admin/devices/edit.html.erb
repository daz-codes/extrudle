<% content_for :title, "Rename #{@device.name}" %>
<p class="mb-2"><%= link_to "← Computers", admin_devices_path, class: "link text-sm" %></p>
<h1 class="page-title mb-6">Rename computer</h1>
<%= form_with model: [ :admin, @device ], class: "card max-w-xl space-y-5 p-6" do |form| %>
  <%= form.error_summary %>
  <%= form.text_row :name, required: true, maxlength: 60, autofocus: true %>
  <div class="flex flex-wrap gap-3">
    <%= form.submit "Save", class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_devices_path, class: "btn btn-secondary" %>
  </div>
<% end %>
