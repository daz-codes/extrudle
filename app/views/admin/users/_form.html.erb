<%= form_with model: [:admin, user], class: "card max-w-2xl space-y-5 p-6" do |form| %>
  <% if user.errors.any? %>
    <div role="alert" class="rounded-md border border-bad-600/30 bg-bad-50 px-4 py-3 text-bad-700">
      <p class="font-semibold">Please fix the following:</p>
      <ul class="mt-1 list-disc pl-5">
        <% user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "field-label" %>
    <%= form.text_field :name, required: true, autofocus: true, class: "field-input" %>
  </div>

  <div>
    <%= form.label :email_address, "Email address", class: "field-label" %>
    <%= form.email_field :email_address, required: true, class: "field-input" %>
  </div>

  <fieldset>
    <legend class="field-label">Role</legend>
    <div class="grid gap-2 sm:grid-cols-3">
      <% { "admin" => "Everything, including users", "office" => "Planning, orders, stock", "floor" => "Floor screens only" }.each do |role, hint| %>
        <label class="choice items-start p-3">
          <%= form.radio_button :role, role, class: "mt-1 size-5 accent-ink-900" %>
          <span>
            <span class="block font-semibold"><%= role.humanize %></span>
            <span class="block text-sm text-ink-600"><%= hint %></span>
          </span>
        </label>
      <% end %>
    </div>
  </fieldset>

  <label class="flex min-h-12 cursor-pointer items-center gap-3">
    <%= form.check_box :active, class: "size-5 accent-ink-900" %>
    <span class="font-semibold">Active</span>
    <span class="text-sm text-ink-600">Deactivated users can't sign in.</span>
  </label>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= form.label :password, class: "field-label" %>
      <%= form.password_field :password, autocomplete: "new-password", maxlength: 72, required: user.new_record?, class: "field-input" %>
      <% if user.persisted? %><p class="field-hint">Leave blank to keep the current password.</p><% end %>
    </div>
    <div>
      <%= form.label :password_confirmation, "Repeat password", class: "field-label" %>
      <%= form.password_field :password_confirmation, autocomplete: "new-password", maxlength: 72, required: user.new_record?, class: "field-input" %>
    </div>
  </div>

  <div class="flex flex-wrap gap-3">
    <%= form.submit user.new_record? ? "Add user" : "Save changes", class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_users_path, class: "btn btn-secondary" %>
  </div>
<% end %>
