<%= form_with model: customer, class: "card max-w-3xl space-y-5 p-6" do |form| %>
  <%= form.error_summary %>
  <%= form.text_row :name, required: true, autofocus: true %>
  <div class="grid gap-5 sm:grid-cols-3">
    <%= form.text_row :contact_name %>
    <%= form.email_row :email %>
    <%= form.telephone_row :phone %>
  </div>
  <%= form.text_area_row :address %>
  <%= form.radio_row :currency, Currency::CODES, hint: "Prices and invoices for this customer use this currency." %>
  <div class="grid gap-5 sm:grid-cols-[1fr_2fr]">
    <%= form.text_row :sage_account_ref, label: "Sage account reference", maxlength: 8, class: "field-input font-mono uppercase",
          hint: "As in Sage 50, e.g. BRIGHT01. Needed to export invoices." %>
    <%= form.radio_row :sage_tax_code, SageExport.tax_codes, label: "Sage VAT code",
          labels: { "T0" => "T0 zero rated", "T1" => "T1 standard 20%", "T2" => "T2 exempt", "T4" => "T4 EU sales" } %>
  </div>
  <%= colour_picker "customer[colour]", customer.colour,
        hint: "Jobs for this customer show in this colour on the planner. Each job can change it." %>
  <% if customer.errors[:colour].any? %><p class="text-sm font-medium text-bad-700"><%= customer.errors.full_messages_for(:colour).to_sentence %></p><% end %>
  <%= form.text_area_row :notes %>
  <%= form.check_row :active, hint: "Inactive customers are hidden from new orders." %>
  <%= render "master_data/form_actions", form: form, cancel_path: customer.persisted? ? customer : customers_path %>
<% end %>
