<% content_for :title, "Customers" %>
<%= render "master_data/header", title: "Customers", action: "Add customer", action_path: new_customer_path %>
<%= render "master_data/filters", placeholder: "Search name or contact" %>

<div class="card overflow-x-auto">
  <table class="data-table w-full text-left">
    <thead>
      <tr>
        <th scope="col" class="px-4 py-3">Name</th>
        <th scope="col" class="px-4 py-3">Contact</th>
        <th scope="col" class="px-4 py-3">Currency</th>
        <th scope="col" class="px-4 py-3">Status</th>
      </tr>
    </thead>
    <tbody>
      <% @customers.each do |customer| %>
        <tr id="<%= dom_id(customer) %>" class="<%= "text-ink-500" unless customer.active? %>">
          <td class="px-4 py-3"><%= link_to customer.name, customer, class: "link font-semibold" %></td>
          <td class="px-4 py-3"><%= [customer.contact_name, customer.email].compact_blank.join(" · ").presence || "—" %></td>
          <td class="px-4 py-3"><%= customer.currency %></td>
          <td class="px-4 py-3"><%= status_badge(customer) %></td>
        </tr>
      <% end %>
      <% if @customers.empty? %><%= render "master_data/empty", message: "No customers match.", colspan: 4 %><% end %>
    </tbody>
  </table>
</div>
