<% content_for :title, "New delivery note" %>
<p class="mb-2"><%= link_to "← Dispatch", dispatch_path, class: "link text-sm" %></p>
<h1 class="page-title mb-2">New delivery note</h1>
<p class="mb-6 text-ink-600"><%= link_to @order.number, @order, class: "link" %> · <%= @order.customer.name %><%= " · PO #{@order.customer_po_ref}" if @order.customer_po_ref %></p>
<%= render "form", note: @note, order: @order, pallets: @pallets, selected: @selected %>
