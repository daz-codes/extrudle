<% content_for :title, "Home" %>

<div class="mb-8">
  <h1 class="page-title">Good to see you, <%= Current.user.name.split.first %></h1>
  <p class="mt-1 text-ink-600"><%= l(Time.current, format: "%A %-d %B %Y, %H:%M") %> (UK time)</p>
</div>

<%# Each card links to its section. A section still to be built has no path yet and shows its slice instead. %>
<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  <% [
       [ "Planner", "Production queue per line, replacing form 5.4.1.1.", planner_path ],
       [ "Sales orders", "Customer orders and required dates.", sales_orders_path ],
       [ "Production", "Production logs: despatch runs and QA checks (5.4.1.2).", production_runs_path ],
       [ "Stock", "Goods in, lots, locations, labels and stock on hand.", stock_path ],
       [ "Dispatch", "Delivery notes from finished pallets, and the Sage export.", dispatch_path ],
       [ "Purchasing", "Purchase orders to suppliers, with a PDF to email.", purchase_orders_path ],
       [ "Master data", "Customers, suppliers, materials, lines and specs.", master_data_path ]
     ].each do |title, blurb, path, coming_in = nil| %>
    <% if path %>
      <%= link_to path, class: "card block p-5" do %>
        <h2 class="section-title"><%= title %></h2>
        <p class="mt-2 text-ink-600"><%= blurb %></p>
      <% end %>
    <% else %>
      <section class="card p-5">
        <div class="flex items-start justify-between gap-3">
          <h2 class="section-title"><%= title %></h2>
          <span class="badge badge-quiet">Coming in <%= coming_in %></span>
        </div>
        <p class="mt-2 text-ink-600"><%= blurb %></p>
      </section>
    <% end %>
  <% end %>
</div>
