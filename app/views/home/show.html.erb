<% content_for :title, "Home" %>

<div class="mb-8">
  <h1 class="page-title">Good to see you, <%= Current.user.name.split.first %></h1>
  <p class="mt-1 text-ink-600"><%= l(Time.current, format: "%A %-d %B %Y, %H:%M") %> (UK time)</p>
</div>

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  <% [
       ["Planner", "Production queue per line, replacing form 5.4.1.1.", "Slice 3–4"],
       ["Sales orders", "Customer orders and required dates.", "Slice 2"],
       ["Stock", "Goods in, lots, locations, labels and stock on hand.", "Slice 6"],
       ["Purchasing", "Purchase orders to suppliers, with a PDF to email.", "Slice 5"],
       ["Production logs", "Despatch runs, reels and QA checks (5.4.1.2).", "Slice 7"],
       ["Master data", "Customers, suppliers, materials, lines and specs.", "Slice 1"]
     ].each do |title, blurb, slice| %>
    <section class="card p-5">
      <div class="flex items-start justify-between gap-3">
        <h2 class="section-title"><%= title %></h2>
        <span class="badge badge-quiet"><%= slice %></span>
      </div>
      <p class="mt-2 text-ink-600"><%= blurb %></p>
    </section>
  <% end %>
</div>
