<!DOCTYPE html>
<html lang="en-GB">
  <head>
    <%= render "shared/head" %>
  </head>

  <body class="min-h-screen">
    <header class="bg-brand-900 text-white">
      <nav class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-2" aria-label="Main">
        <%= link_to root_path, class: "inline-flex min-h-12 items-center text-white" do %>
          <%= render "shared/wordmark" %>
        <% end %>

        <div class="flex flex-wrap items-center gap-1">
          <%= nav_link "Home", root_path %>
          <%= nav_link "Floor", floor_root_path, active: false %>
          <% if Current.user&.admin? %>
            <%= nav_link "Users", admin_users_path, active: controller_path == "admin/users" %>
          <% end %>
        </div>

        <div class="ml-auto flex items-center gap-3">
          <span class="text-sm text-brand-100">
            <span class="font-semibold text-white"><%= Current.user.name %></span>
            <span class="badge ml-1 bg-brand-700 text-brand-50"><%= Current.user.role.humanize %></span>
          </span>
          <%= button_to "Sign out", session_path, method: :delete,
                class: "inline-flex min-h-12 cursor-pointer items-center rounded-md px-3 text-sm font-medium text-brand-100 hover:bg-brand-800 hover:text-white" %>
        </div>
      </nav>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-8">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
