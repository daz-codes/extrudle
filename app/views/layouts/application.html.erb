<!DOCTYPE html>
<html lang="en-GB">
  <head>
    <%= render "shared/head" %>
  </head>

  <body class="min-h-screen">
    <header class="app-header">
      <nav class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-8 gap-y-2 px-4 py-3" aria-label="Main">
        <%= link_to root_path, class: "inline-flex min-h-12 items-center" do %>
          <%= render "shared/wordmark" %>
        <% end %>

        <div class="flex flex-wrap items-center gap-1">
          <%= nav_link "Home", root_path %>
          <%= nav_link "Master data", master_data_path, active: master_data_page? %>
          <%= nav_link "Floor", floor_root_path, active: false %>
          <% if Current.user&.admin? %>
            <%= nav_link "Users", admin_users_path, active: controller_path == "admin/users" %>
          <% end %>
        </div>

        <div class="ml-auto flex items-center gap-3">
          <span class="text-sm">
            <span class="font-semibold"><%= Current.user.name %></span>
            <span class="badge badge-quiet ml-1"><%= Current.user.role.humanize %></span>
          </span>
          <%= button_to "Sign out", session_path, method: :delete, class: "nav-link" %>
        </div>
      </nav>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-10">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

  </body>
</html>
