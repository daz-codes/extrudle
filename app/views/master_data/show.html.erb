<% content_for :title, "Master data" %>
<%= render "master_data/header", title: "Master data" %>

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  <% {
       product_specs: "Product specs, with line rates per line.",
       customers: "Who we make film for.",
       suppliers: "Who we buy polymer and additives from.",
       materials: "Virgin, recycled and in-house regrind.",
       material_categories: "Groups for stock reports.",
       lines: "Extrusion lines and changeover defaults."
     }.each do |name, blurb| %>
    <%= link_to url_for(name), class: "card group block p-5 transition hover:border-brand-300 hover:shadow" do %>
      <div class="flex items-baseline justify-between gap-3">
        <h2 class="text-lg font-semibold text-slate-900 group-hover:text-brand-700"><%= MasterDataHelper::MASTER_DATA_SECTIONS.to_h.invert[name] %></h2>
        <span class="text-2xl font-bold tabular-nums text-brand-700"><%= @counts[name] %></span>
      </div>
      <p class="mt-2 text-slate-600"><%= blurb %></p>
    <% end %>
  <% end %>
</div>
