<% content_for :title, "Material categories" %>
<%= render "master_data/header", title: "Material categories", action: "Add category", action_path: new_material_category_path %>

<div class="card overflow-x-auto">
  <table class="w-full text-left">
    <thead class="border-b border-slate-200 bg-slate-50 text-sm text-slate-600">
      <tr>
        <th scope="col" class="px-4 py-3 font-semibold">Order</th>
        <th scope="col" class="px-4 py-3 font-semibold">Name</th>
        <th scope="col" class="px-4 py-3 font-semibold">Description</th>
        <th scope="col" class="px-4 py-3 text-right font-semibold">Materials</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @material_categories.each do |category| %>
        <tr id="<%= dom_id(category) %>">
          <td class="px-4 py-3 tabular-nums text-slate-500"><%= category.position %></td>
          <td class="px-4 py-3"><%= link_to category.name, edit_material_category_path(category), class: "font-semibold text-brand-700 underline-offset-2 hover:underline" %></td>
          <td class="px-4 py-3"><%= category.description.presence || "—" %></td>
          <td class="px-4 py-3 text-right tabular-nums"><%= link_to category.materials.size, materials_path(category: category), class: "text-brand-700 underline" %></td>
        </tr>
      <% end %>
      <% if @material_categories.empty? %><%= render "master_data/empty", message: "No categories yet.", colspan: 4 %><% end %>
    </tbody>
  </table>
</div>
