<% content_for :title, "Material categories" %>
<%= render "master_data/header", title: "Material categories", action: "Add category", action_path: new_material_category_path %>

<div class="card overflow-x-auto">
  <table class="data-table w-full text-left">
    <thead>
      <tr>
        <th scope="col" class="px-4 py-3">Order</th>
        <th scope="col" class="px-4 py-3">Name</th>
        <th scope="col" class="px-4 py-3">Description</th>
        <th scope="col" class="px-4 py-3 text-right">Materials</th>
      </tr>
    </thead>
    <tbody>
      <% @material_categories.each do |category| %>
        <tr id="<%= dom_id(category) %>">
          <td class="px-4 py-3 tabular-nums text-ink-500"><%= category.position %></td>
          <td class="px-4 py-3"><%= link_to category.name, edit_material_category_path(category), class: "link font-semibold" %></td>
          <td class="px-4 py-3"><%= category.description.presence || "—" %></td>
          <td class="px-4 py-3 text-right tabular-nums"><%= link_to category.materials.size, materials_path(category: category), class: "link" %></td>
        </tr>
      <% end %>
      <% if @material_categories.empty? %><%= render "master_data/empty", message: "No categories yet.", colspan: 4 %><% end %>
    </tbody>
  </table>
</div>
