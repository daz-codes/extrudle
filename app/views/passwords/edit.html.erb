<% content_for :title, "New password" %>

<h1 class="mb-6 text-2xl font-bold text-ink-900">Choose a new password</h1>

<%= form_with url: password_path(params[:token]), method: :put, class: "space-y-5" do |form| %>
  <div>
    <%= form.label :password, "New password", class: "field-label" %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "field-input" %>
  </div>

  <div>
    <%= form.label :password_confirmation, "Repeat new password", class: "field-label" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "field-input" %>
  </div>

  <%= form.submit "Save password", class: "btn btn-primary w-full" %>
<% end %>
