<% content_for :title, "Forgot password" %>

<h1 class="mb-2 text-2xl font-bold text-ink-900">Forgot your password?</h1>
<p class="mb-6 text-ink-600">We'll email you a link to set a new one.</p>

<%= form_with url: passwords_path, class: "space-y-5" do |form| %>
  <div>
    <%= form.label :email_address, "Email address", class: "field-label" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "field-input" %>
  </div>

  <%= form.submit "Email reset instructions", class: "btn btn-primary w-full" %>

  <p class="text-center text-sm">
    <%= link_to "Back to sign in", new_session_path, class: "font-medium text-brand-700 underline hover:no-underline" %>
  </p>
<% end %>
