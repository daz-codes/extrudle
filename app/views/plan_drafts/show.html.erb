<% content_for :title, "Publish the new plan" %>
<% changes = @publish.changes %>
<% notes = @publish.notes %>

<p class="mb-2"><%= link_to "← Back to the draft", planner_path, class: "link text-sm" %></p>
<h1 class="page-title mb-3">Publish the new plan</h1>
<p class="mb-6 max-w-3xl text-ink-600">
  Draft started <%= l(@draft.created_at, format: "%a %-d %b %H:%M") %><%= " by #{@draft.started_by.name}" if @draft.started_by %>.
  Publishing replaces the live plan on every line in one step. The floor sees it straight away.
</p>

<section class="card mb-6 overflow-x-auto" aria-labelledby="changes-heading">
  <h2 id="changes-heading" class="section-title px-5 pt-5">What changes</h2>
  <table class="data-table mt-3 w-full text-left">
    <thead>
      <tr>
        <th scope="col" class="px-4 py-3">Line</th>
        <th scope="col" class="px-4 py-3 text-right">New blocks</th>
        <th scope="col" class="px-4 py-3 text-right">Removed</th>
        <th scope="col" class="px-4 py-3 text-right">Moved or changed</th>
      </tr>
    </thead>
    <tbody>
      <% changes.each do |change| %>
        <tr id="<%= dom_id(change.line, :changes) %>">
          <td class="px-4 py-3 font-semibold"><%= link_to "Line #{change.line.name}", planner_path(line: change.line.name), class: "link" %></td>
          <td class="px-4 py-3 text-right tabular-nums"><%= change.added %></td>
          <td class="px-4 py-3 text-right tabular-nums"><%= change.removed %></td>
          <td class="px-4 py-3 text-right tabular-nums"><%= change.changed %></td>
        </tr>
      <% end %>
      <% if changes.none?(&:any?) %>
        <tr><td colspan="4" class="px-4 py-3 text-ink-600">The draft is the same as the live plan.</td></tr>
      <% end %>
    </tbody>
  </table>
</section>

<section class="card mb-6 p-5" aria-labelledby="meanwhile-heading">
  <h2 id="meanwhile-heading" class="section-title mb-3">Since the draft began</h2>
  <% if notes.any? %>
    <ul class="list-disc space-y-2 pl-6">
      <% notes.each do |note| %><li><%= note %></li><% end %>
    </ul>
  <% else %>
    <p class="text-ink-600">Nothing has started, been cancelled or been added.</p>
  <% end %>
</section>

<div class="flex flex-wrap gap-3">
  <%= button_to "Publish the new plan", publish_plan_draft_path, method: :post, class: "btn btn-accent",
        form: { data: { turbo_confirm: "Publish the new plan? It replaces the live plan on every line." } } %>
  <%= link_to "Keep editing", planner_path, class: "btn btn-secondary" %>
</div>
