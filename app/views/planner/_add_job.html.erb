<section class="card p-5" aria-labelledby="add-job-heading">
  <h2 id="add-job-heading" class="section-title">Orders to plan</h2>
  <p class="mt-1 mb-4 text-sm text-ink-600">Most pressing first. Adds to the end of line <%= @line.name %>; move it afterwards.</p>

  <% if @unplanned.empty? %>
    <p class="rounded-[11px] bg-ink-50 p-4 text-ink-600">Every open order is planned.</p>
  <% else %>
    <ul class="space-y-3">
      <% @unplanned.first(12).each do |order_line| %>
        <% order = order_line.sales_order %>
        <% rate = order_line.product_spec.rate_for(@line) %>
        <li id="<%= dom_id(order_line, :unplanned) %>" class="rounded-[14px] border border-ink-200 p-4 <%= "bg-lemon-50" if order.urgent? %>">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <span class="font-semibold text-ink-900"><%= order.number %> · <%= order_line.product_spec %></span>
            <span class="text-sm"><%= required_date(order) %> <%= urgent_badge(order) %></span>
          </div>
          <p class="text-sm text-ink-600"><%= order.customer.name %> · <%= kg(order_line.unplanned_g) %> to plan<%= " of #{kg(order_line.quantity_g)}" if order_line.planned_g.positive? %></p>
          <p class="text-sm <%= rate ? "text-ink-500" : "font-medium text-ink-800" %>">
            <% if rate %>
              <%= rate.kg_per_hour %> kg/h on <%= @line.name %> ≈ <%= duration_text(Schedule.job_minutes(order_line.unplanned_g, rate.kg_per_hour)) %>
            <% else %>
              <span class="badge badge-lemon mr-1">No rate</span><%= @line.name %> has no rate for this spec. Enter an estimated time.
            <% end %>
          </p>
          <%= form_with url: schedule_blocks_path, class: "mt-3 flex flex-wrap items-end gap-2" do |form| %>
            <%= hidden_field_tag :line_id, @line.id, id: nil %>
            <%= hidden_field_tag :sales_order_line_id, order_line.id, id: nil %>
            <%= hidden_field_tag :week, @week_start.iso8601, id: nil %>
            <div class="w-32">
              <%= label_tag "planned_kg_#{order_line.id}", "Planned kg", class: "field-label" %>
              <div class="field-group">
                <%= text_field_tag :planned_kg, DecimalInput.from_scaled_integer(order_line.unplanned_g, Weight::GRAMS_PER_KG), id: "planned_kg_#{order_line.id}", inputmode: "decimal", class: "field-input" %>
              </div>
            </div>
            <% unless rate %>
              <div class="w-24">
                <%= label_tag "duration_hours_#{order_line.id}", "Hours", class: "field-label" %>
                <%= number_field_tag :duration_hours, nil, id: "duration_hours_#{order_line.id}", min: 0.5, step: 0.5, required: true, class: "field-input" %>
              </div>
            <% end %>
            <%= render "planner/queue_start_field", prefix: "job_#{order_line.id}" %>
            <%= form.submit "Add to #{@line.name}", class: "btn btn-accent", aria: { label: "Add #{order.number} #{order_line.product_spec} to line #{@line.name}" } %>
          <% end %>
        </li>
      <% end %>
    </ul>
    <% if @unplanned.size > 12 %>
      <p class="mt-3 text-sm text-ink-600"><%= @unplanned.size - 12 %> more. <%= link_to "See all orders", sales_orders_path, class: "link" %></p>
    <% end %>
  <% end %>
</section>
