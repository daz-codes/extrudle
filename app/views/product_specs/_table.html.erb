<%# locals: (product_specs:, show_customer: true) %>
<table class="data-table w-full text-left">
  <thead>
    <tr>
      <th scope="col" class="px-4 py-3">Spec</th>
      <% if show_customer %><th scope="col" class="px-4 py-3">Customer</th><% end %>
      <th scope="col" class="px-4 py-3 text-right">Micron</th>
      <th scope="col" class="px-4 py-3 text-right">Width</th>
      <th scope="col" class="px-4 py-3">Silicone</th>
      <th scope="col" class="px-4 py-3">Rates (kg/h)</th>
      <th scope="col" class="px-4 py-3">Status</th>
    </tr>
  </thead>
  <tbody>
    <% product_specs.each do |spec| %>
      <tr id="<%= dom_id(spec) %>" class="<%= "text-ink-500" unless spec.active? %>">
        <td class="px-4 py-3">
          <%= link_to spec.to_s, spec, class: "link font-semibold" %>
          <% if spec.customer_description.present? %><div class="text-sm text-ink-500"><%= spec.customer_description %></div><% end %>
        </td>
        <% if show_customer %><td class="px-4 py-3"><%= spec.customer&.name || "Stock / any" %></td><% end %>
        <td class="px-4 py-3 text-right tabular-nums"><%= spec.thickness_micron %></td>
        <td class="px-4 py-3 text-right tabular-nums"><%= mm(spec.width_mm) %></td>
        <td class="px-4 py-3"><%= silicone_summary(spec) %></td>
        <td class="px-4 py-3 tabular-nums">
          <% if spec.line_rates.any? %>
            <%= safe_join(spec.line_rates.sort_by { _1.line.position }.map { |rate| "#{rate.line.name} #{rate.kg_per_hour}" }, " · ") %>
          <% elsif Line.active.where.not(default_kg_per_hour: nil).exists? %>
            <span class="text-ink-500">Line defaults</span>
          <% else %>
            <span class="badge badge-lemon">No rates</span>
          <% end %>
        </td>
        <td class="px-4 py-3"><%= status_badge(spec) %></td>
      </tr>
    <% end %>
    <% if product_specs.empty? %><%= render "master_data/empty", message: "No specs yet.", colspan: show_customer ? 7 : 6 %><% end %>
  </tbody>
</table>
