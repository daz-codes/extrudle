<% spec = @product_spec %>
<% content_for :title, "Spec #{spec}" %>
<%= render "master_data/tabs" %>

<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
  <div>
    <div class="flex items-center gap-3">
      <h1 class="page-title">Spec <%= spec %></h1>
      <%= status_badge(spec) %>
    </div>
    <p class="mt-1 text-ink-600">
      <%= spec.customer ? link_to(spec.customer.name, spec.customer, class: "link") : "Stock / any customer" %>
      <% if spec.customer_description.present? %> · <%= spec.customer_description %><% end %>
    </p>
  </div>
  <div class="flex flex-wrap gap-3">
    <%= link_to "Edit", edit_product_spec_path(spec), class: "btn btn-secondary" %>
    <%= link_to "Duplicate as new", new_product_spec_path(copy_from: spec), class: "btn btn-accent" %>
  </div>
</div>

<%# Same columns as the paper Extrusion Production Plan (form 5.4.1.1) so it reads familiarly. %>
<section class="card mb-6 overflow-x-auto" aria-labelledby="plan-row-heading">
  <h2 id="plan-row-heading" class="eyebrow px-5 pt-4">As it appears on the production plan</h2>
  <table class="data-table mt-2 w-full text-left">
    <thead>
      <tr>
        <th scope="col" class="px-4 py-2">Customer refs</th>
        <th scope="col" class="px-4 py-2">Micron</th>
        <th scope="col" class="px-4 py-2">Width</th>
        <th scope="col" class="px-4 py-2">PE</th>
        <th scope="col" class="px-4 py-2">Silicone</th>
        <th scope="col" class="px-4 py-2">Antiblock</th>
        <th scope="col" class="px-4 py-2">Reel size</th>
        <th scope="col" class="px-4 py-2">Additional info &amp; packaging</th>
      </tr>
    </thead>
    <tbody>
      <tr class="align-top">
        <td class="px-4 py-3 text-sm">
          <% { "Part" => spec.customer_part_no, "Tool" => spec.customer_tool_no, "Product" => spec.customer_product_code }.each do |label, value| %>
            <% if value.present? %><div><span class="text-ink-500"><%= label %>:</span> <%= value %></div><% end %>
          <% end %>
        </td>
        <td class="px-4 py-3 text-lg font-semibold tabular-nums"><%= spec.paper_gauge %></td>
        <td class="px-4 py-3 text-lg font-semibold tabular-nums"><%= spec.width_mm %></td>
        <td class="px-4 py-3"><%= yes_no(spec.pe) %></td>
        <td class="px-4 py-3"><%= silicone_summary(spec) %></td>
        <td class="px-4 py-3"><%= yes_no(spec.antiblock) %><% if spec.antifog_bp %><div class="font-semibold">Anti-fog <%= spec.antifog_pct %>%</div><% end %></td>
        <td class="px-4 py-3"><%= reel_size_summary(spec) %></td>
        <td class="px-4 py-3 text-sm">
          <%= spec.core_inches %>" core, <%= spec.core_orientation %>.
          <%= spec.pallet_type.humanize %> pallet<%= ", #{spec.reels_per_pallet} per pallet" if spec.reels_per_pallet %>.
          <%= "Label inside core." if spec.label_inside_core %>
          <% if spec.packaging_notes.present? %><div class="mt-1 whitespace-pre-line"><%= spec.packaging_notes %></div><% end %>
        </td>
      </tr>
    </tbody>
  </table>
</section>

<div class="grid gap-6 lg:grid-cols-2">
  <section class="card p-5">
    <h2 class="section-title mb-3">Details</h2>
    <dl class="divide-y divide-ink-100">
      <% {
           "Thickness" => micron(spec.thickness_micron),
           "Width" => mm(spec.width_mm),
           "Material type" => spec.material_type.humanize,
           "Core" => "#{spec.core_inches} inch, #{spec.core_orientation}",
           "Max reel weight" => kg(spec.max_reel_g),
         }.each do |label, value| %>
        <div class="flex justify-between gap-4 py-2"><dt class="text-ink-600"><%= label %></dt><dd class="font-medium tabular-nums"><%= value %></dd></div>
      <% end %>
      <div class="flex justify-between gap-4 py-2">
        <dt class="text-ink-600">Revision</dt>
        <dd class="flex flex-wrap justify-end gap-2">
          <% spec.revisions.each do |revision| %>
            <% if revision == spec %>
              <span class="badge badge-lime font-mono">rev <%= revision.revision %></span>
            <% else %>
              <%= link_to "rev #{revision.revision}", revision, class: "badge badge-quiet font-mono hover:bg-ink-200", aria: { label: "Revision #{revision.revision}" } %>
            <% end %>
          <% end %>
        </dd>
      </div>
      <div class="flex justify-between gap-4 py-2">
        <dt class="text-ink-600">On orders</dt>
        <dd class="font-medium tabular-nums"><%= spec.sales_order_lines.count %></dd>
      </div>
    </dl>
  </section>

  <section class="card p-5" aria-labelledby="line-rates-heading">
    <h2 id="line-rates-heading" class="section-title">Line rates</h2>
    <p class="mb-4 text-sm text-ink-600">Output on each line. The planner uses this to work out how long a job takes. Leave it blank to use the line's default rate, where it has one.</p>

    <div class="space-y-3">
      <% @lines.each do |line| %>
        <% rate = spec.rate_for(line) %>
        <div id="<%= dom_id(line, :rate) %>" class="flex flex-wrap items-center gap-3 rounded-md border border-ink-200 p-3">
          <div class="w-16 text-xl font-bold"><%= line.name %></div>
          <%= form_with model: rate || LineRate.new(line: line), url: rate ? product_spec_line_rate_path(spec, rate) : product_spec_line_rates_path(spec),
                class: "flex flex-1 flex-wrap items-center gap-3" do |form| %>
            <%= form.hidden_field :line_id %>
            <div class="flex-1">
              <%= form.label :kg_per_hour, "Rate on #{line.name}", class: "sr-only" %>
              <div class="field-group">
                <%= form.number_field :kg_per_hour, min: 1, step: 1, required: true, placeholder: line.default_kg_per_hour ? "Line default #{line.default_kg_per_hour}" : "Not set", class: "field-input tabular-nums" %>
                <span class="field-suffix">kg/h</span>
              </div>
            </div>
            <%= form.submit "Save", class: "btn btn-primary", aria: { label: "Save rate for #{line.name}" } %>
          <% end %>
          <% if rate %>
            <%= button_to "Remove", product_spec_line_rate_path(spec, rate), method: :delete, class: "btn btn-secondary",
                  form: { data: { turbo_confirm: "Remove the rate for #{line.name}?" } }, aria: { label: "Remove rate for #{line.name}" } %>
          <% end %>
        </div>
      <% end %>
      <% if @lines.empty? %>
        <p class="text-ink-500">No active lines. <%= link_to "Add a line", new_line_path, class: "link" %>.</p>
      <% end %>
    </div>
  </section>
  <% recipe = spec.recipe %>
  <section class="card p-5" aria-labelledby="recipe-heading">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <h2 id="recipe-heading" class="section-title">Recipe</h2>
      <% if recipe.custom? %><span class="badge badge-quiet">Own recipe</span><% else %><span class="badge badge-lemon">Standard recipe</span><% end %>
    </div>
    <p class="mb-4 mt-2 text-sm text-ink-600">The share of each feed in the film. Used to work out how much of each bag a production log used.</p>
    <%= form_with url: product_spec_recipe_path(spec), method: :patch, scope: :recipe, class: "space-y-4" do |form| %>
      <div class="grid grid-cols-2 gap-4">
        <% MaterialLoad::FEEDS.each do |feed, label| %>
          <div>
            <%= form.label feed, label, class: "field-label" %>
            <div class="field-group">
              <%= form.text_field feed, value: recipe.percent(feed), inputmode: "decimal", class: "field-input tabular-nums" %>
              <span class="field-suffix">%</span>
            </div>
          </div>
        <% end %>
      </div>
      <p class="field-hint">The four shares add up to 100%.</p>
      <div class="flex flex-wrap gap-3">
        <%= form.submit "Save recipe", class: "btn btn-primary" %>
      </div>
    <% end %>
    <% if recipe.custom? %>
      <%= button_to "Use the standard recipe", product_spec_recipe_path(spec), method: :delete, class: "btn btn-secondary mt-3",
            form: { data: { turbo_confirm: "Go back to the standard recipe for #{spec}?" } } %>
    <% end %>
  </section>
</div>
