<% run = @run %>
<% spec = run.product_spec %>
<% content_for :title, "Despatch #{run.despatch_number}" %>

<p class="mb-2"><%= link_to "← #{Current.user.floor? ? "Floor" : "Production"}", production_home_path, class: "link text-sm" %></p>
<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <div>
    <p class="eyebrow">Production log 5.4.1.2 · Line <%= run.line.name %></p>
    <div class="mt-1 flex flex-wrap items-center gap-3">
      <h1 class="page-title">Despatch <span class="font-mono"><%= run.despatch_number %></span></h1>
      <%= run_status_badge(run) %>
    </div>
    <p class="mt-2 text-ink-600">Started <%= l(run.started_at, format: "%a %-d %b %Y %H:%M") %><%= " by #{run.started_by.name}" if run.started_by %></p>
  </div>
  <% if run.editable? %>
    <%= link_to "Edit details", edit_production_run_path(run), class: "btn btn-secondary" %>
  <% end %>
</div>

<section class="card mb-6 p-5" aria-labelledby="job-heading">
  <h2 id="job-heading" class="section-title mb-4">Job</h2>
  <dl class="grid grid-cols-2 gap-x-6 gap-y-3 sm:grid-cols-3 lg:grid-cols-5">
    <% run_header_fields(run).each do |label, value| %>
      <div>
        <dt class="eyebrow"><%= label %></dt>
        <dd class="font-medium text-ink-900"><%= value %></dd>
      </div>
    <% end %>
  </dl>
</section>

<div class="mb-6 grid gap-6 lg:grid-cols-2">
  <section class="card p-5" aria-labelledby="details-heading">
    <h2 id="details-heading" class="section-title mb-4">Batch numbers and technicians</h2>
    <dl class="grid grid-cols-2 gap-x-6 gap-y-3">
      <% {
           "Antiblock batch" => run.antiblock_batch_no,
           "Silicone batch" => run.silicone_batch_no,
           "PE film batch" => run.pe_film_batch_no,
           "Technician (days)" => run.technician_days,
           "Technician (nights)" => run.technician_nights
         }.each do |label, value| %>
        <div>
          <dt class="eyebrow"><%= label %></dt>
          <dd class="font-medium <%= value ? "text-ink-900" : "text-ink-500" %>"><%= value || "Not filled in" %></dd>
        </div>
      <% end %>
    </dl>
  </section>

  <section class="card p-5" aria-labelledby="instructions-heading">
    <h2 id="instructions-heading" class="section-title mb-4">Special instructions</h2>
    <p class="whitespace-pre-line"><%= run.special_instructions.presence || "None." %></p>
    <h2 class="section-title mt-6 mb-2">Comments and corrective actions</h2>
    <p class="whitespace-pre-line"><%= run.comments.presence || "None yet." %></p>
  </section>
</div>

<section id="prestart" class="card mb-6 p-5" aria-labelledby="prestart-heading">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <h2 id="prestart-heading" class="section-title">Prestart checks</h2>
    <% if run.prestart_complete? %><span class="badge bg-ok-50 font-semibold text-ok-700">All done</span><% end %>
  </div>
  <ul class="divide-y divide-ink-100">
    <% ProductionRun::Checklist.items("prestart").each do |item, label| %>
      <% answer = run.answer("prestart", item) %>
      <li class="flex flex-wrap items-center justify-between gap-3 py-3" id="check_prestart_<%= item %>">
        <div>
          <p class="font-semibold"><%= label %></p>
          <% if answer %>
            <p class="text-sm text-ink-600"><%= pass_fail_badge(answer.passed?) %> <%= checked_by(answer) %><%= " · #{answer.note}" if answer.note %></p>
          <% else %>
            <p class="text-sm text-ink-500">Not checked yet</p>
          <% end %>
        </div>
        <% if run.editable? %>
          <div class="flex gap-2">
            <% [ [ "Yes", true ], [ "No", false ] ].each do |text, value| %>
              <%= button_to text, production_run_checks_path(run), params: { stage: "prestart", item:, passed: value },
                    class: "choice min-w-20 justify-center #{"border-ink-900 bg-lime-100 font-semibold" if answer && answer.passed? == value}",
                    aria: { label: "#{label}: #{text.downcase}" } %>
            <% end %>
          </div>
        <% end %>
      </li>
    <% end %>
  </ul>
</section>

<section id="startup" class="card mb-6 p-5" aria-labelledby="startup-heading">
  <h2 id="startup-heading" class="section-title mb-1">Width and thickness</h2>
  <p class="mb-4 text-sm text-ink-600">Measured at start-up. Green is in tolerance, red is out.</p>
  <div class="grid gap-6 md:grid-cols-2">
    <% ProductionRun::Checklist::MEASUREMENTS.each do |item, info| %>
      <% readings = run.measurements(item) %>
      <div id="measure_<%= item %>">
        <h3 class="font-semibold"><%= info[:label] %></h3>
        <p class="mb-3 text-sm text-ink-600"><%= tolerance_text(item, spec) %></p>
        <% if run.editable? %>
          <%= form_with url: production_run_checks_path(run), method: :post, class: "mb-3 flex items-end gap-2" do %>
            <%= hidden_field_tag :stage, "startup", id: nil %>
            <%= hidden_field_tag :item, item, id: nil %>
            <div class="flex-1">
              <%= label_tag "actual_#{item}", "#{info[:label]} actual", class: "sr-only" %>
              <div class="field-group">
                <%= text_field_tag :actual, nil, id: "actual_#{item}", inputmode: "decimal", autocomplete: "off", required: true, class: "field-input",
                      placeholder: (item == "thickness" ? "e.g. #{spec.thickness_micron} or #{spec.paper_gauge}" : "e.g. #{spec.width_mm}") %>
                <span class="field-suffix"><%= info[:unit] %></span>
              </div>
            </div>
            <%= submit_tag "Record", name: nil, class: "btn btn-primary", aria: { label: "Record #{info[:label].downcase}" } %>
          <% end %>
        <% end %>
        <% if readings.any? %>
          <ul class="space-y-1">
            <% readings.reverse_each do |check| %>
              <li class="flex flex-wrap items-center gap-2 rounded-md px-3 py-2 <%= check.passed? ? "bg-ok-50" : "bg-bad-50" %>">
                <%= pass_fail_badge(check.passed?) %> <%= reading(check) %>
                <span class="text-sm text-ink-600"><%= checked_by(check) %></span>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-sm text-ink-500">No readings yet.</p>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
