<% order = @purchase_order %>
<% content_for :title, order.number %>
<% receiving = order.receivable? || order.received? %>

<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <div>
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="page-title">Purchase order <%= order.number %></h1>
      <%= po_status_badge(order) %>
    </div>
    <p class="mt-2 text-ink-600">
      <%= link_to order.supplier.name, edit_supplier_path(order.supplier), class: "link" %>
      <% if order.supplier_ref %> · Ref <%= order.supplier_ref %><% end %>
      <% if order.sent_at && !order.draft? %> · Sent <%= l(order.sent_at, format: "%-d %b %Y") %><% end %>
    </p>
  </div>
  <div class="flex flex-wrap gap-3">
    <% if order.draft? %>
      <%= link_to "Edit PO", edit_purchase_order_path(order), class: "btn btn-secondary" %>
      <%= link_to "Preview PDF", purchase_order_path(order, format: :pdf), class: "btn btn-secondary", target: "_blank" %>
      <% if order.lines.any? %>
        <%= button_to "Mark as sent", mark_sent_purchase_order_path(order), method: :patch, class: "btn btn-accent",
              form: { data: { turbo_confirm: "Mark #{order.number} as sent to #{order.supplier.name}?" } } %>
      <% end %>
    <% else %>
      <%= link_to "Download PDF", purchase_order_path(order, format: :pdf), class: "btn #{order.sent? ? "btn-accent" : "btn-secondary"}", target: "_blank" %>
    <% end %>
    <% if order.receivable? %>
      <%= link_to "Receive goods", new_purchase_order_receipt_path(order), class: "btn btn-primary" %>
    <% end %>
    <% if order.part_received? %>
      <%= button_to "Close short", close_short_purchase_order_path(order), method: :patch, class: "btn btn-secondary",
            form: { data: { turbo_confirm: "Close #{order.number}? Nothing more will be expected against it." } } %>
    <% end %>
    <% if order.sent? %>
      <%= button_to "Back to draft", back_to_draft_purchase_order_path(order), method: :patch, class: "btn btn-secondary",
            form: { data: { turbo_confirm: "Take #{order.number} back to draft to change it? You'll need to send it again." } } %>
    <% end %>
    <% if order.draft? || order.sent? %>
      <%= button_to "Cancel PO", cancel_purchase_order_path(order), method: :patch, class: "btn btn-secondary",
            form: { data: { turbo_confirm: "Cancel #{order.number}?" } } %>
    <% elsif order.cancelled? %>
      <%= button_to "Reopen as draft", reopen_purchase_order_path(order), method: :patch, class: "btn btn-secondary" %>
    <% end %>
  </div>
</div>

<% if order.closed_short? %>
  <p class="mb-6 rounded-md bg-ink-100 px-4 py-3 text-ink-900">
    Closed short on <%= l(order.closed_short_at.to_date, format: "%-d %b %Y") %>: <%= order_quantity(order.received_g) %> received of <%= order_quantity(order.total_g) %> ordered.
  </p>
<% end %>

<% if order.draft? && order.lines.any? %>
  <p class="mb-6 rounded-md bg-lemon-100 px-4 py-3 text-ink-900">
    This PO is a draft. Check it with <strong>Preview PDF</strong>, then <strong>Mark as sent</strong> and email the PDF to <%= order.supplier.name %>.
  </p>
<% end %>

<div class="mb-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  <section class="card p-5">
    <h2 class="eyebrow">Expected delivery</h2>
    <p class="mt-2 text-xl font-semibold"><%= expected_date(order) %></p>
  </section>
  <section class="card p-5">
    <h2 class="eyebrow">Total weight</h2>
    <p class="mt-2 font-mono text-xl font-semibold tabular-nums"><%= order.lines.any? ? order_quantity(order.total_g) : "—" %></p>
  </section>
  <section class="card p-5">
    <h2 class="eyebrow">Value (<%= order.currency %>)</h2>
    <p class="mt-2 font-mono text-xl font-semibold tabular-nums"><%= order.lines.any? ? money(order.total_cents, order.currency) : "—" %></p>
  </section>
  <section class="card p-5">
    <h2 class="eyebrow">Incoterm</h2>
    <p class="mt-2 font-mono text-xl font-semibold"><%= order.incoterm || "—" %></p>
  </section>
</div>

<% if order.notes.present? %>
  <section class="card mb-6 p-5">
    <h2 class="section-title mb-2">Notes</h2>
    <p class="whitespace-pre-line"><%= order.notes %></p>
  </section>
<% end %>

<section class="card mb-6 overflow-x-auto" aria-labelledby="lines-heading">
  <h2 id="lines-heading" class="section-title px-5 pt-5">Lines</h2>
  <table class="data-table mt-3 w-full text-left">
    <thead>
      <tr>
        <th scope="col" class="px-4 py-3">Material</th>
        <th scope="col" class="px-4 py-3">Category</th>
        <th scope="col" class="px-4 py-3 text-right">Quantity</th>
        <% if receiving %><th scope="col" class="px-4 py-3 text-right">Received</th><% end %>
        <th scope="col" class="px-4 py-3 text-right">Price / t</th>
        <th scope="col" class="px-4 py-3 text-right">Total</th>
        <th scope="col" class="px-4 py-3"><span class="sr-only">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      <% order.lines.each do |line| %>
        <% material = line.material %>
        <tr id="<%= dom_id(line) %>">
          <td class="px-4 py-3 font-semibold"><%= material %></td>
          <td class="px-4 py-3 text-sm"><%= material.material_category.name %></td>
          <td class="px-4 py-3 text-right tabular-nums"><%= order_quantity(line.quantity_g, unit: line.quantity_unit) %></td>
          <% if receiving %>
            <td class="px-4 py-3 text-right tabular-nums">
              <% if line.received_g.positive? %>
                <%= link_to order_quantity(line.received_g), lots_path(po_line: line.id, empty: 1), class: "link #{"text-ok-700" if line.fully_received?}" %>
              <% else %>
                <span class="text-ink-500">—</span>
              <% end %>
            </td>
          <% end %>
          <td class="px-4 py-3 text-right tabular-nums"><%= money(line.price_per_tonne_cents, order.currency) %></td>
          <td class="px-4 py-3 text-right tabular-nums"><%= money(line.total_cents, order.currency) %></td>
          <td class="px-4 py-3">
            <% if order.editable? %>
              <div class="flex justify-end gap-2">
                <%= link_to "Edit", edit_purchase_order_line_path(order, line), class: "btn btn-secondary", aria: { label: "Edit line for #{material}" } %>
                <%= button_to "Remove", purchase_order_line_path(order, line), method: :delete, class: "btn btn-secondary",
                      form: { data: { turbo_confirm: "Remove #{material} from this PO?" } }, aria: { label: "Remove line for #{material}" } %>
              </div>
            <% end %>
          </td>
        </tr>
      <% end %>
      <% if order.lines.none? %><%= render "master_data/empty", message: "No lines yet. Add one below.", colspan: 6 %><% end %>
    </tbody>
    <% if order.lines.size > 1 %>
      <tfoot>
        <tr class="border-t border-ink-200 font-semibold">
          <th scope="row" colspan="2" class="px-4 py-3">Total</th>
          <td class="px-4 py-3 text-right tabular-nums"><%= order_quantity(order.total_g) %></td>
          <% if receiving %><td class="px-4 py-3 text-right tabular-nums"><%= order_quantity(order.received_g) %></td><% end %>
          <td></td>
          <td class="px-4 py-3 text-right tabular-nums"><%= money(order.total_cents, order.currency) %></td>
          <td></td>
        </tr>
      </tfoot>
    <% end %>
  </table>
</section>

<% if @line %>
  <section class="card max-w-3xl p-6" aria-labelledby="add-line-heading">
    <h2 id="add-line-heading" class="section-title mb-5">Add a line</h2>
    <%= render "purchase_order_lines/form", order: order, line: @line %>
  </section>
<% end %>
