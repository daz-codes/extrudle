<% if notice.present? %>
  <div id="notice" role="status" class="mb-6 rounded-md border border-ok-600/30 bg-ok-50 px-4 py-3 font-medium text-ok-700"><%= notice %></div>
<% end %>
<% if alert.present? %>
  <div id="alert" role="alert" class="mb-6 rounded-md border border-bad-600/30 bg-bad-50 px-4 py-3 font-medium text-bad-700"><%= alert %></div>
<% end %>
