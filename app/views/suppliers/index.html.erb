<% content_for :title, "Suppliers" %>
<%= render "master_data/header", title: "Suppliers", action: "Add supplier", action_path: new_supplier_path %>
<%= render "master_data/filters", placeholder: "Search name, country or contact" %>

<div class="card overflow-x-auto">
  <table class="data-table w-full text-left">
    <thead>
      <tr>
        <th scope="col" class="px-4 py-3">Name</th>
        <th scope="col" class="px-4 py-3">Country</th>
        <th scope="col" class="px-4 py-3">Contact</th>
        <th scope="col" class="px-4 py-3">Terms</th>
        <th scope="col" class="px-4 py-3">Status</th>
      </tr>
    </thead>
    <tbody>
      <% @suppliers.each do |supplier| %>
        <tr id="<%= dom_id(supplier) %>" class="<%= "text-ink-500" unless supplier.active? %>">
          <td class="px-4 py-3"><%= link_to supplier.name, edit_supplier_path(supplier), class: "link font-semibold" %></td>
          <td class="px-4 py-3"><%= supplier.country.presence || "—" %></td>
          <td class="px-4 py-3"><%= [supplier.contact_name, supplier.email].compact_blank.join(" · ").presence || "—" %></td>
          <td class="px-4 py-3"><%= [supplier.currency, supplier.incoterm].compact.join(" · ") %></td>
          <td class="px-4 py-3"><%= status_badge(supplier) %></td>
        </tr>
      <% end %>
      <% if @suppliers.empty? %><%= render "master_data/empty", message: "No suppliers match.", colspan: 5 %><% end %>
    </tbody>
  </table>
</div>
